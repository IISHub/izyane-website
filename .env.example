# Contact form (Netlify Function: netlify/functions/contact.ts)
# Set these in Netlify > Site configuration > Environment variables.
# They are server-side only - do NOT prefix with VITE_.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@izyane.com
SMTP_PASS=your_mailbox_or_app_password
# Optional: where enquiries go (defaults to info@izyane.com)
CONTACT_TO=info@izyane.com
# Optional: sender address (defaults to SMTP_USER)
CONTACT_FROM=info@izyane.com

VITE_GEMINI_API_KEY=gemini-api-key
